# Public URL of this marketing site (used for canonical links, sitemap and the same-origin check).
NEXT_PUBLIC_SITE_URL=https://www.ceynx.com

# Where registration requests are delivered. Any HTTPS endpoint that accepts a JSON POST:
# Slack incoming webhook, Make, Zapier, n8n, Google Apps Script, or your own CRM.
# Keep it secret: set it in Vercel → Project → Settings → Environment Variables.
LEAD_WEBHOOK_URL=

# Optional: sent as "Authorization: Bearer <value>" to LEAD_WEBHOOK_URL.
LEAD_WEBHOOK_SECRET=
